# Supabase Project URL
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# New public browser key (safe to expose through /api/config when RLS is enabled)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only key used to validate signed-in users before geocoding.
# NEVER put this value in client-side code.
SUPABASE_SECRET_KEY=sb_secret_xxx
