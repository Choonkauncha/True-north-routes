# Supabase Project URL
SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Browser-safe publishable key (RLS must be enabled)
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server-only key. NEVER ship this to the browser.
# /api/accounts also accepts SUPABASE_SERVICE_ROLE_KEY when this name is unset.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Comma-separated exact admin emails. Passwords belong in Supabase Auth, not source code.
ADMIN_EMAILS=truenorthrestorationss@gmail.com,travisbishopmackie@gmail.com
